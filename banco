show databases;


CREATE TABLE IF NOT EXISTS dados_pessoais(
nome VARCHAR(100),
cargo VARCHAR(100) UNIQUE NOT NULL,
bio VARCHAR(200) UNIQUE NOT NULL,
info_principal VARCHAR(500) UNIQUE NOT NULL
);

CREATE TABLE IF NOT EXISTS contatos(
email VARCHAR(500) UNIQUE NOT NULL,
telefone VARCHAR(1000) NOT NULL,
perfis_prof VARCHAR (500)
);

CREATE TABLE IF NOT EXISTS experiencias(
empresa VARCHAR(100) NOT NULL,
funcao VARCHAR(100) NOT NULL UNIQUE,
perido_trabalho VARCHAR(200) NOT NULL,
descricao VARCHAR(200) NOT NULL
);

drop table experiencias;


CREATE TABLE IF NOT EXISTS formacao(
instituicao INT PRIMARY KEY AUTO_INCREMENT,
curso VARCHAR(100) NOT NULL UNIQUE,
perido VARCHAR(200) NOT NULL
);

